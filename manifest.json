{
  "manifest_version": 3,
  "name": "Tirumala SevaPilot — TTD Booking Assistant",
  "version": "1.0.0",
  "description": "Prepare your TTD booking details before the booking window. Store pilgrim info locally, validate, and fill forms accurately. Independent third-party utility — not affiliated with TTD.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://ttdevasthanams.ap.gov.in/*",
    "https://tirupatibalaji.ap.gov.in/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open SevaPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://tirupatibalaji.ap.gov.in/*"
      ],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "open-sevapilot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open SevaPilot Side Panel"
    },
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Scan current TTD page"
    },
    "autofill-page": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Trigger SevaPilot Autofill"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://ttdevasthanams.ap.gov.in/*", "https://tirupatibalaji.ap.gov.in/*"]
    }
  ]
}
